{
    "name": "knight-tour",
    "version": "1.0.0",
    "description": "A Knight's Tour solver with genetic algorithm",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "start": "browser-sync start --server --index public/index.html --port 3000 --no-watch --no-ui --no-notify --no-open",
        "server": "node --experimental-strip-types src/server/server.ts",
        "dev": "concurrently \"npm run server\" \"npm run start\""
    },
    "keywords": [
        "javascript",
        "genetic algorithm",
        "sqlite",
        "knight's tour",
        "memory"
    ],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@libsql/client": "^0.17.0",
        "better-sqlite3": "^11.10.0",
        "browser-sync": "^3.0.4",
        "concurrently": "^9.2.1",
        "knex": "^3.1.0"
    }
}
